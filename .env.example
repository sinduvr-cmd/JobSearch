# =================================================================
# Job Search & Recommendation App - Environment Template (.env.example)
# Copy this file to .env and configure your MySQL credentials.
# =================================================================

# MySQL Connection Parameters
# Option A: Local MySQL (default port 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_search_rec
DB_USER=root
DB_PASSWORD=your_local_mysql_password

# Option B: Cloud MySQL (e.g. Aiven, AWS RDS, PlanetScale)
# DB_HOST=your-cloud-host.aivencloud.com
# DB_PORT=13596
# DB_NAME=job_search_rec
# DB_USER=avnadmin
# DB_PASSWORD=your_cloud_password

# External Jobs REST API
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
API_TIMEOUT_SECONDS=10
API_CACHE_TTL_SECONDS=600

# Application Defaults
DEFAULT_PROFILE_ID=1
